{
  "name": "breakpoint",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first Safe control discovery and rehearsal workbench",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=22 <23", "npm": ">=10 <11" },
  "scripts": {
    "compile": "hardhat --config hardhat.config.cjs compile",
    "build:core": "tsc -p packages/core/tsconfig.json",
    "build:scenario": "npm run build:core && tsc -p packages/scenario/tsconfig.json",
    "build": "npm run build:scenario && npm run build --workspace @breakpoint/web",
    "typecheck": "npm run build:scenario && npm run typecheck --workspace @breakpoint/web",
    "test": "npm run test:contracts && npm run test:analysis",
    "test:contracts": "hardhat --config hardhat.config.cjs test",
    "test:analysis": "npm run build:core && mocha test/analysis.test.cjs",
    "test:scenario": "node scripts/verify-scenario.cjs",
    "test:e2e": "playwright test",
    "demo": "node scripts/demo.cjs",
    "demo:reset": "node scripts/reset-demo.cjs",
    "diagnose": "node scripts/diagnose.cjs"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "@nomicfoundation/solidity-analyzer-win32-x64-msvc": "0.1.2",
    "@openzeppelin/contracts": "5.4.0",
    "@playwright/test": "1.63.0",
    "@safe-global/safe-smart-account": "1.5.0",
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "chai": "4.5.0",
    "ethers": "6.17.0",
    "hardhat": "2.28.0",
    "typescript": "5.9.3"
  }
}
